// Telegram Birthday Assistant — data model (SPEC-1)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique @map("telegram_id")
  username   String?
  firstName  String?   @map("first_name")
  timezone   String    @default("Europe/Warsaw")
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  sessions          TelegramSession[]
  contacts          Contact[]
  reminderRules     ReminderRule[]
  reminderJobs      ReminderJob[]
  drafts            MessageDraft[]
  scheduledMessages ScheduledMessage[]
  messageLogs       MessageLog[]
  onboardingState   OnboardingState?
  authAttempts      AuthAttempt[]
  exportLogs        ExportLog[]

  @@map("users")
}

model TelegramSession {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  phoneNumber      String   @map("phone_number")
  encryptedSession String   @map("encrypted_session")
  sessionIv        String   @map("session_iv")
  sessionAuthTag   String   @map("session_auth_tag")
  status           String   @default("active")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_sessions")
}

model Contact {
  id             Int       @id @default(autoincrement())
  ownerUserId    Int       @map("owner_user_id")
  telegramUserId BigInt?   @map("telegram_user_id")
  fullName       String    @map("full_name")
  username       String?
  phone          String?
  normalizedPhone String?  @map("normalized_phone")
  birthDate      DateTime? @map("birth_date") @db.Date
  birthTime      String    @default("00:00") @map("birth_time")
  rankingScore   Int       @default(0) @map("ranking_score")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner             User               @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  reminderJobs      ReminderJob[]
  drafts            MessageDraft[]
  scheduledMessages ScheduledMessage[]
  messageLogs       MessageLog[]

  @@index([ownerUserId])
  @@index([telegramUserId])
  @@index([normalizedPhone])
  @@index([username])
  @@map("contacts")
}

model ReminderRule {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  daysBefore Int     @map("days_before")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderJobs ReminderJob[]

  @@index([userId])
  @@map("reminder_rules")
}

model ReminderJob {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  contactId      Int      @map("contact_id")
  reminderRuleId Int?     @map("reminder_rule_id")
  remindAt       DateTime @map("remind_at")
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  reminderRule ReminderRule? @relation(fields: [reminderRuleId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([remindAt])
  @@map("reminder_jobs")
}

model MessageDraft {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  contactId     Int       @map("contact_id")
  draftText     String    @map("draft_text")
  scheduledTime DateTime? @map("scheduled_time")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("message_drafts")
}

model ScheduledMessage {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  contactId    Int      @map("contact_id")
  messageText  String   @map("message_text")
  scheduledFor DateTime @map("scheduled_for")
  status       String   @default("pending")
  bullmqJobId  String?  @map("bullmq_job_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledFor])
  @@map("scheduled_messages")
}

model MessageLog {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  contactId         Int       @map("contact_id")
  telegramMessageId BigInt?   @map("telegram_message_id")
  messageText       String    @map("message_text")
  status            String
  errorMessage      String?   @map("error_message")
  sentAt            DateTime? @map("sent_at")
  retryAt           DateTime? @map("retry_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("message_logs")
}

model OnboardingState {
  userId      Int      @id @map("user_id")
  currentStep String   @map("current_step")
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

model AuthAttempt {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  phoneNumber   String   @map("phone_number")
  phoneCodeHash String?  @map("phone_code_hash")
  status        String   @default("pending")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("auth_attempts")
}

model ExportLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  exportType String   @map("export_type")
  fileName   String   @map("file_name")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("export_logs")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   BigInt   @map("admin_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_logs")
}
