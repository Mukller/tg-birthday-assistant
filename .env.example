NODE_ENV=development
PORT=3000

# Telegram Bot API token from @BotFather
BOT_TOKEN=

# MTProto credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 32-byte hex key for AES-256-GCM session encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Your numeric Telegram id (for the hidden admin panel)
ADMIN_TELEGRAM_ID=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/birthday_assistant?schema=public
REDIS_URL=redis://localhost:6379

SEND_DELAY_MIN_SEC=5
SEND_DELAY_MAX_SEC=20
RATE_LIMIT_PER_HOUR=25
DEFAULT_TIMEZONE=Europe/Warsaw
